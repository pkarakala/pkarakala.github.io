---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
export async function getStaticPaths() {
  const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return notes.length ? [{ params: { collection: 'notes' }, props: { notes } }] : [];
}
const { notes } = Astro.props;
---
<Base title="Notes — Pranav Reddy" description="Experiment logs, technical write-ups, and project updates by Pranav Reddy." current="notes" canonical="/notes.html">
  <header class="page-intro"><p class="eyebrow">Writing & experiments</p><h1>Notes</h1></header>
  <section class="section" aria-label="Published notes"><ul class="note-list">{notes.map(note => <li><time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}</time><h2><a href={`/notes/${note.id}.html`}>{note.data.title}</a></h2><p>{note.data.description}</p></li>)}</ul></section>
</Base>
