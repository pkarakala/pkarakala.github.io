---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/profile';
const projects = (await getCollection('work', ({ data }) => !data.draft && data.featuredOrder !== undefined)).sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);
---
<Base title="Pranav Reddy — Projects, research & work in progress" description="The personal portfolio of Pranav Reddy, BS/MS+1 candidate in Electronics & Photonics at UC Santa Barbara. Projects, research, and work in progress." canonical="/">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-identity"><p class="eyebrow">Personal portfolio</p><h1 id="home-title">Pranav <span>Reddy</span></h1></div>
    <div class="hero-details"><p class="education">{profile.degree}<br /><span>{profile.university}</span></p><div class="hero-intro"><p>{profile.introduction}</p><div class="hero-actions"><a class="button" href="#work">View work <Arrow direction="down" /></a><a class="text-link" href={profile.resume}>Resume <Arrow /></a></div></div></div>
  </section>
  <section class="section work-section" id="work" aria-labelledby="work-title">
    <span id="research" class="legacy-anchor" aria-hidden="true"></span><span id="labs" class="legacy-anchor" aria-hidden="true"></span>
    <div class="section-heading heading-with-link"><div><p class="eyebrow">Projects & research</p><h2 id="work-title">Selected work</h2></div><a class="text-link" href="/work.html">All work <Arrow direction="right" /></a></div>
    <div class="project-list">{projects.map((project, index) => <ProjectRow project={project} index={index} />)}</div>
    <a class="archive-link text-link" href="/work.html">Explore the full work archive <Arrow direction="right" /></a>
  </section>
  <Experience /><About /><Contact />
</Base>
