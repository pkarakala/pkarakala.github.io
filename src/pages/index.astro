---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Arrow from '../components/Arrow.astro';
import FloatingLogo from '../components/FloatingLogo.astro';
import { profile } from '../data/profile';
import { superscriptRuns } from '../lib/superscript';
const projects = (await getCollection('work', ({ data }) => !data.draft && data.featuredOrder !== undefined)).sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);
/* Each figure is copied from a project card on this page and links to it. */
const proof = [
  { value: '4.7σ', label: 'per link for 99% yield across 8,192 optical links, from my link model', href: '#oicd' },
  { value: '3.6 × 10⁻⁸', label: 'simulated bit error rate over 80 km of single mode fiber', href: '#photonic-fiber' },
  { value: '0.130', label: 'g²(0) for heralded single photons I measured, below the 0.5 threshold', href: '#quantum-photonics' },
  { value: '2.26×', label: 'faster fused GPU kernel than the best PyTorch path, verified on one T4', href: '#kernel-relay' },
];
---
<Base title="Pranav Reddy | Photonics and optical interconnect for AI compute" description="Pranav Reddy works where photonics meets AI compute: optical link budgets, fiber link simulation, single photon measurement, and the ML systems that run on it. BS/MS+1 in Electronics & Photonics at UC Santa Barbara." canonical="/">
  <section class="hero" aria-labelledby="home-title">
    <FloatingLogo placement="intro" />
    <div class="hero-identity"><p class="eyebrow">{profile.focus}</p><h1 id="home-title">Pranav <span>Reddy</span></h1></div>
    <div class="hero-details"><p class="education">{profile.degree}<br /><span>{profile.university}</span></p><div class="hero-intro"><p>{profile.introduction}</p><div class="hero-actions"><a class="button" href="#work">View work <Arrow direction="down" /></a><a class="button button-secondary" href={profile.resume}>Resume (PDF) <Arrow /></a><a class="text-link" href="#contact">Get in touch <Arrow direction="right" /></a></div></div></div>
    <ul class="hero-proof" aria-label="Results at a glance">{proof.map(item => <li><a href={item.href}><span class="proof-value">{superscriptRuns(item.value).map(run => run.sup ? <sup>{run.text}</sup> : run.text)}</span><span class="proof-label">{item.label}</span></a></li>)}</ul>
  </section>
  <section class="section work-section" id="work" aria-labelledby="work-title">
    <span id="research" class="legacy-anchor" aria-hidden="true"></span><span id="labs" class="legacy-anchor" aria-hidden="true"></span>
    <div class="section-heading heading-with-link"><div><p class="eyebrow">Projects & research</p><h2 id="work-title">Selected work</h2></div><a class="text-link" href="/work.html">All work <Arrow direction="right" /></a></div>
    <div class="project-list">{projects.map((project, index) => <ProjectRow project={project} index={index} />)}</div>
    <a class="archive-link text-link" href="/work.html">Explore the full work archive <Arrow direction="right" /></a>
  </section>
  <Experience /><About /><Contact />
</Base>
