---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import Arrow from '../components/Arrow.astro';
---
<Base title="Contact — Pranav Reddy" description="Get in touch with Pranav Reddy by email, or find him on GitHub and LinkedIn." canonical="/contact.html">
  <section class="page-intro document-section"><p class="eyebrow">Contact</p><h1>Get in touch.</h1><div class="standalone-contact"><p class="email-address">{profile.emailDisplay}</p><div class="social-links"><a href={profile.github}>GitHub<Arrow /></a><a href={profile.linkedin}>LinkedIn<Arrow /></a></div></div></section>
</Base>
