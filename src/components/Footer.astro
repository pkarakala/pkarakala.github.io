---
import { profile } from '../data/profile';
import Arrow from './Arrow.astro';
---
<footer class="site-footer shell">
  <span>© {new Date().getFullYear()} {profile.name}</span>
  <div class="footer-tools"><button class="quiet-button motion-toggle" type="button" data-motion-toggle aria-label="Decorative motion" aria-pressed="false" hidden><span class="motion-indicator" aria-hidden="true"></span><span data-motion-label>Motion off</span></button><a href="#top">Back to top <Arrow direction="up" /></a></div>
</footer>
