---
import { experience } from '../data/experience';
---
<section class="section split-section" id="experience" aria-labelledby="experience-title">
  <div class="section-heading"><p class="eyebrow">Along the way</p><h2 id="experience-title">Experience</h2></div>
  <div class="experience-list">
    {experience.map(item => <div class="experience-row"><div><h3>{item.organization}</h3><p>{item.role}</p></div><p class="experience-dates">{item.dates}</p></div>)}
  </div>
</section>
