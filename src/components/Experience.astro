---
import { experience } from '../data/experience';
import Arrow from './Arrow.astro';
---
<section class="section split-section experience-section" id="experience" aria-labelledby="experience-title">
  <div class="section-heading"><p class="eyebrow">Along the way</p><h2 id="experience-title">Experience</h2></div>
  <div class="experience-list">
    {experience.map(item => <div class="experience-row"><div><h3>{item.url ? <a class="experience-link" href={item.url}>{item.organization} <Arrow direction={item.url.startsWith('/') ? 'right' : undefined} /></a> : item.organization}</h3><p>{item.role}</p><p class="experience-summary">{item.summary}</p></div><p class="experience-dates">{item.dates}</p></div>)}
  </div>
</section>
